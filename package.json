{
  "name": "dogfood-os",
  "version": "1.0.0",
  "private": true,
  "description": "DOGFOOD OS - Agent-native operating system for fair judged events",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace=apps/api",
    "test:benchmark": "node tests/run-benchmarks.js",
    "seed": "npm run seed --workspace=apps/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "hackathon",
    "judging",
    "offline-first",
    "dogfood",
    "auditability"
  ],
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
