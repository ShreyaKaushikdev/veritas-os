# Where the browser sends API calls. See src/lib/api.ts (API_BASE_URL).
#
# LEAVE THIS UNSET IN PRODUCTION. When it is unset and NODE_ENV=production the
# base becomes "" and every call is same-origin + relative (e.g. /api/v1/auth/login).
# The top-level rewrites in vercel.json forward those paths to the `api` service.
#
# Only set it to an ABSOLUTE origin when the API lives on a different host.
# Do NOT set it to "/api" - call paths already include /api, which would produce
# /api/api/v1/...
#
# Local dev only: points the browser straight at the NestJS server on :4000.
NEXT_PUBLIC_API_URL="http://localhost:4000"

NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
