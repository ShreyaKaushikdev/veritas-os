// Prisma Schema for DOGFOOD OS - MongoDB Backend with Strong Authentication
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  VISITOR
  PARTICIPANT
  JUDGE
  ORGANIZER
  ADMIN
}

// ✅ STRONG AUTHENTICATION: Immutable Email-Role Binding
// Once created, a user's email and role cannot be changed across different users
// This prevents account takeover and role escalation attacks
model UserRoleBinding {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  email          String   @unique
  role           Role     @default(PARTICIPANT)
  isEmailVerified Boolean @default(false)
  firstLoginAt   DateTime?
  lockedUntil    DateTime? // Security lockout if suspicious activity detected
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
}

enum EventStatus {
  DRAFT
  REGISTRATION_OPEN
  SUBMISSION_OPEN
  SUBMISSION_FROZEN
  JUDGING_OPEN
  RESULTS_FINALIZED
  RESULTS_PUBLISHED
  ARCHIVED
}

enum ProjectEligibility {
  PENDING
  ELIGIBLE
  DISQUALIFIED
}

enum BallotStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  LOCKED
  REOPENED
  VOIDED
}

enum AutopilotMode {
  OFF
  ASSIST
  FULL
}

// ✅ STRONG AUTHENTICATION: Enhanced User Model
model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(PARTICIPANT)
  isVerified   Boolean  @default(false)
  
  // OTP for email verification
  otp          String?
  otpExpiresAt DateTime?
  
  // Google OAuth (optional)
  googleId     String?  @unique
  
  // ✅ STRONG AUTHENTICATION: Failed login tracking for brute force protection
  lastLoginAt  DateTime?
  loginAttempts Int     @default(0)
  failedLoginAttempts Int @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil  DateTime? // Account locked after repeated failed attempts
  lockReason   String?  // Reason for lockout (e.g., "BRUTE_FORCE", "SUSPICIOUS_ACTIVITY")
  
  // ✅ STRONG AUTHENTICATION: Password security
  passwordChangedAt DateTime?
  previousPasswordHashes String[] @default([]) // Track last 5 passwords to prevent reuse
  passwordResetToken String? @unique
  passwordResetExpiresAt DateTime?
  
  // ✅ STRONG AUTHENTICATION: Role change history
  roleChangeHistory RoleChangeLog[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  memberships  Membership[]
  teamMembers  TeamMember[]
  assignments  Assignment[]
  ballots      Ballot[]
  auditEvents  AuditEvent[]
  judgeProfile JudgePassport?
  conflicts    JudgeConflict[]
  pairwiseVotes PairwiseComparison[]
  supportTickets SupportTicket[]
  chatMessages   ChatMessage[]
  emailOptInFuture Boolean @default(false)
  
  @@index([email])
  @@index([googleId])
  @@index([lastLoginAt])
  @@index([lockedUntil])
}

// ✅ STRONG AUTHENTICATION: Track all role changes for audit
model RoleChangeLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oldRole   Role
  newRole   Role
  changedBy String? // Admin user ID if changed by organizer
  reason    String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

// ✅ STRONG AUTHENTICATION: Session tracking with IP/Device
model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Device fingerprinting
  ipAddress String?
  userAgent String?
  deviceId  String?  // Browser fingerprint
  
  // Session security
  isActive  Boolean  @default(true)
  revokedAt DateTime? // When session was invalidated
  
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ✅ STRONG AUTHENTICATION: Login attempts for security monitoring
model LoginAttempt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  ipAddress String
  userAgent String?
  success   Boolean
  reason    String? // Failed reason: INVALID_PASSWORD, ACCOUNT_LOCKED, EMAIL_NOT_VERIFIED, etc.
  createdAt DateTime @default(now())
  
  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
}

model JudgePassport {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @unique @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedReviews  Int      @default(0)
  medianReviewSecs  Int      @default(0)
  calibrationBias   Float    @default(0.0)
  reliabilityScore  Float    @default(1.0)
  eligibleTracks    String   @default("[]")
  notes             String?
  updatedAt         DateTime @updatedAt
  
  @@index([userId])
}

model JudgeConflict {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([projectId])
}

model Event {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  slug           String         @unique
  name           String
  description    String
  status         EventStatus    @default(DRAFT)
  autopilotMode  AutopilotMode  @default(ASSIST)
  timezone       String         @default("UTC")
  regDeadline    DateTime?
  subDeadline    DateTime?
  freezeDeadline DateTime?
  judgeDeadline  DateTime?
  minReviews     Int            @default(3)
  disagreeThreshold Float       @default(1.5)
  currentRubricId String?       @db.ObjectId
  blindReviewMode Boolean       @default(false)
  shuffleSeed     String        @default("dogfood-entropy-seed-2026")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tracks         Track[]
  prizes         Prize[]
  teams          Team[]
  projects       Project[]
  rubrics        RubricVersion[]
  anchorProjects AnchorProject[]
  rankingRuns    RankingRun[]
  auditEvents    AuditEvent[]
  hashNodes      IntegrityHashNode[]
  memberships    Membership[]
  supportTickets SupportTicket[]
  chatMessages   ChatMessage[]
  pairwise       PairwiseComparison[]
  
  @@index([slug])
}

model Membership {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String   @db.ObjectId
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role      Role     @default(PARTICIPANT)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
}

model Track {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String   @db.ObjectId
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String
  projects    Project[]
  
  @@index([eventId])
}

model Prize {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String   @db.ObjectId
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String
  amount      String?
  
  @@index([eventId])
}

model RubricVersion {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String           @db.ObjectId
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  version     Int              @default(1)
  isLocked    Boolean          @default(false)
  criteria    RubricCriteria[]
  ballots     Ballot[]
  rankingRuns RankingRun[]
  createdAt   DateTime         @default(now())
  
  @@index([eventId])
}

model RubricCriteria {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  rubricVersionId String        @db.ObjectId
  rubricVersion   RubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Cascade)
  name            String
  description     String
  weight          Float         @default(0.25)
  minScore        Float         @default(1.0)
  maxScore        Float         @default(10.0)
  guidance        String?
  scores          BallotScore[]
  
  @@index([rubricVersionId])
}

model AnchorProject {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String   @db.ObjectId
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String
  tier        String
  targetScores String
  createdAt   DateTime @default(now())
  
  @@index([eventId])
}

model Team {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String       @db.ObjectId
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  inviteCode  String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members     TeamMember[]
  project     Project?
  
  @@index([eventId])
  @@index([inviteCode])
}

model TeamMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  teamId    String   @db.ObjectId
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
}

model Project {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  eventId      String             @db.ObjectId
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamId       String             @unique @db.ObjectId
  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  trackId      String?            @db.ObjectId
  track        Track?             @relation(fields: [trackId], references: [id], onDelete: SetNull)
  title        String
  tagline      String?
  description  String
  repoUrl      String?
  demoUrl      String?
  techStack    String?
  featuresList String?
  teamHours    Int                @default(48)
  eligibility  ProjectEligibility @default(PENDING)
  isFrozen     Boolean            @default(false)
  frozenHash   String?
  frozenAt     DateTime?
  license      String?            @default("MIT")
  isOriginalWork Boolean          @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  versions     ProjectVersion[]
  assignments  Assignment[]
  ballots      Ballot[]
  rankedIn     RankedProject[]
  conflicts    JudgeConflict[]
  ideaReports  IdeaReport[]
  pairwiseA    PairwiseComparison[] @relation("PairwiseA")
  pairwiseB    PairwiseComparison[] @relation("PairwiseB")

  @@index([eventId])
  @@index([teamId])
}

model ProjectVersion {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @db.ObjectId
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNumber Int
  title       String
  description String
  repoUrl     String?
  demoUrl     String?
  techStack   String?
  contentHash String
  editorId    String
  reason      String?
  createdAt   DateTime @default(now())
  
  @@index([projectId])
}

model IdeaReport {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId          String?  @db.ObjectId
  project            Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventId            String   @db.ObjectId
  inputSummary       String
  minPotential       Float
  maxPotential       Float
  confidence         String
  confidenceReason   String
  scopePressure      String
  scopeReason        String
  blindSpots         String
  improvementActions String
  criteriaBands      String
  createdAt          DateTime @default(now())
  
  @@index([projectId])
  @@index([eventId])
}

model Assignment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String   @db.ObjectId
  projectId   String   @db.ObjectId
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  judgeId     String   @db.ObjectId
  judge       User     @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  isTargeted  Boolean  @default(false)
  triggerReason String?
  status      String   @default("ACTIVE")
  recusalReason String?
  recusalNote String?
  createdAt   DateTime @default(now())

  @@unique([projectId, judgeId])
  @@index([eventId])
  @@index([judgeId])
}

model Ballot {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  eventId         String        @db.ObjectId
  projectId       String        @db.ObjectId
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  judgeId         String        @db.ObjectId
  judge           User          @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  rubricVersionId String        @db.ObjectId
  rubricVersion   RubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Restrict)
  status          BallotStatus  @default(IN_PROGRESS)
  weightedScore   Float         @default(0.0)
  feedback        String?
  privateNotes    String?
  isFlagged       Boolean       @default(false)
  flagReason      String?
  submittedAt     DateTime?
  ballotHash      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  scores          BallotScore[]

  @@unique([projectId, judgeId, rubricVersionId])
  @@index([eventId])
  @@index([judgeId])
}

model BallotScore {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  ballotId    String         @db.ObjectId
  ballot      Ballot         @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  criteriaId  String         @db.ObjectId
  criteria    RubricCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  score       Float
  comment     String?

  @@unique([ballotId, criteriaId])
}

model RankingRun {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  eventId         String          @db.ObjectId
  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rubricVersionId String          @db.ObjectId
  rubricVersion   RubricVersion   @relation(fields: [rubricVersionId], references: [id], onDelete: Restrict)
  method          String
  parameters      String
  isFinalized     Boolean         @default(false)
  isPublished     Boolean         @default(false)
  runHash         String
  tieBreakLog     String?
  signOffs        String?
  createdAt       DateTime        @default(now())

  rankedProjects  RankedProject[]
  
  @@index([eventId])
}

model RankedProject {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  rankingRunId    String     @db.ObjectId
  rankingRun      RankingRun @relation(fields: [rankingRunId], references: [id], onDelete: Cascade)
  projectId       String     @db.ObjectId
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rank            Int
  rawScore        Float
  normalizedScore Float
  uncertainty     Float
  reviewCount     Int
  scoreStdDev     Float
  disagreementFlag Boolean   @default(false)
  breakdownJson   String
  tieBreakApplied Boolean    @default(false)
  tieBreakReason  String?
}

model AuditEvent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId      String?  @db.ObjectId
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  occurredAt   DateTime @default(now())
  actorId      String   @db.ObjectId
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorRole    Role
  action       String
  resourceType String
  resourceId   String
  beforeHash   String?
  afterHash    String?
  reason       String?
  requestId    String
  
  @@index([eventId])
  @@index([actorId])
  @@index([occurredAt])
}

model IntegrityHashNode {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId      String   @db.ObjectId
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  nodeType     String
  resourceId   String
  previousHash String
  currentHash  String
  payloadJson  String
  timestamp    DateTime @default(now())
  
  @@index([eventId])
  @@index([timestamp])
}

model SupportTicket {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId       String   @db.ObjectId
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reporterId    String   @db.ObjectId
  reporter      User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterRole  String
  page          String
  eventPhase    String
  message       String
  screenshotKey String?
  context       String
  priority      String   @default("NORMAL")
  status        String   @default("OPEN")
  internalNote  String?
  createdAt     DateTime @default(now())

  @@index([eventId])
  @@index([status])
}

model ChatMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String   @db.ObjectId
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  projectId String?  @db.ObjectId
  authorId  String   @db.ObjectId
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([projectId])
}

model PairwiseComparison {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId         String   @db.ObjectId
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judgeId         String   @db.ObjectId
  judge           User     @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  projectAId      String   @db.ObjectId
  projectA        Project  @relation("PairwiseA", fields: [projectAId], references: [id], onDelete: Cascade)
  projectBId      String   @db.ObjectId
  projectB        Project  @relation("PairwiseB", fields: [projectBId], references: [id], onDelete: Cascade)
  winnerId        String?
  isTie           Boolean  @default(false)
  notes           String?
  comparisonHash  String?
  createdAt       DateTime @default(now())

  @@index([eventId])
  @@index([judgeId])
}
