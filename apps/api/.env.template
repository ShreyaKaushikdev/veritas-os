# ================================
# DOGFOOD OS - Environment Configuration
# ================================

# Server Configuration
PORT=4000

# Database Configuration
# Choose ONE option below:

# Option A: PostgreSQL (Recommended for Production)
DATABASE_URL="postgresql://username:password@localhost:5432/dogfood_os?schema=public"

# Option B: SQLite (Quick Development)
# DATABASE_URL="file:./dev.db"
# Note: Also change provider in prisma/schema.prisma to "sqlite"

# Authentication
JWT_SECRET="dogfood_jwt_super_secret_local_key_2026"

# ================================
# GOOGLE OAUTH 2.0 CONFIGURATION
# ================================
# Get from: https://console.cloud.google.com/
# 1. Create project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 Client ID
# 4. Add redirect URI: http://localhost:4000/api/v1/auth/google/callback

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# ================================
# EMAIL CONFIGURATION (NODEMAILER)
# ================================

# Gmail Configuration (Recommended for Development)
# How to get App Password:
# 1. Google Account → Security
# 2. Enable 2-Step Verification
# 3. App passwords → Generate new
# 4. Select "Mail" and your device
# 5. Copy 16-character password

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"

# Alternative Email Providers (Uncomment to use)

# Outlook/Office365
# SMTP_HOST="smtp-mail.outlook.com"
# SMTP_PORT="587"

# Yahoo Mail
# SMTP_HOST="smtp.mail.yahoo.com"
# SMTP_PORT="587"

# SendGrid
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASSWORD="your-sendgrid-api-key"

# AWS SES
# SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
# SMTP_PORT="587"
# SMTP_USER="your-ses-access-key"
# SMTP_PASSWORD="your-ses-secret-key"

# Mailtrap (Testing Only - captures emails without sending)
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT="2525"
# SMTP_USER="your-mailtrap-username"
# SMTP_PASSWORD="your-mailtrap-password"

# Application Settings
APP_NAME="DOGFOOD OS"
FRONTEND_URL="http://localhost:3000"

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_URL="redis://localhost:6379"

# ================================
# STORAGE CONFIGURATION (MinIO/S3)
# ================================
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="dogfood-assets"

# ================================
# AI CONFIGURATION
# ================================
AI_PROVIDER="off"

# ================================
# MONGODB (Optional - if using)
# ================================
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="dogfood_os"
