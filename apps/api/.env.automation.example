# ==========================================
# DOGFOOD OS - Participant Automation Config
# ==========================================

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/dogfood_os"

# Redis (Required for Bull Queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Application
APP_URL=http://localhost:3000
API_PORT=4000
NODE_ENV=development

# ==========================================
# AI SERVICES (Optional - graceful fallback)
# ==========================================

# OpenAI - For AI-powered idea analysis
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude - Alternative AI provider
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ==========================================
# EMAIL SERVICES (Optional - simulated in dev)
# ==========================================

# SendGrid - Transactional emails
# Free tier: 100 emails/day
# Get from: https://sendgrid.com/ → Settings → API Keys
SENDGRID_API_KEY=

# Resend - Modern email API alternative
# Free tier: 3,000 emails/month
# Get from: https://resend.com/ → API Keys
RESEND_API_KEY=

# ==========================================
# MESSAGING PLATFORMS (Optional)
# ==========================================

# Slack Bot Token (for advanced features)
# Get from: https://api.slack.com/apps → OAuth & Permissions
SLACK_BOT_TOKEN=

# Note: Slack/Discord webhooks are configured per-user in notification preferences
# Users provide their own webhook URLs

# ==========================================
# SMS SERVICES (Optional - for urgent alerts)
# ==========================================

# Twilio - SMS notifications
# Free trial: $15 credit
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==========================================
# ANALYTICS (Optional - console logging fallback)
# ==========================================

# Mixpanel - Product analytics
# Free tier: 20M events/month
# Get from: https://mixpanel.com/ → Project Settings
MIXPANEL_TOKEN=

# Amplitude - Alternative analytics
# Free tier: 10M events/month
# Get from: https://amplitude.com/ → Settings
AMPLITUDE_API_KEY=

# ==========================================
# FILE STORAGE (Optional - local filesystem fallback)
# ==========================================

# AWS S3 - Cloud file storage
# Get from: AWS IAM → Users → Create Access Key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=dogfood-uploads
AWS_REGION=us-east-1

# ==========================================
# CALENDAR INTEGRATION (Optional)
# ==========================================

# Google Calendar API
# Get from: https://console.cloud.google.com/
GOOGLE_CALENDAR_API_KEY=

# ==========================================
# SECURITY (Required for Production)
# ==========================================

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Session Secret
SESSION_SECRET=your-session-secret-key

# ==========================================
# DEVELOPMENT HELPERS
# ==========================================

# Enable debug logging
DEBUG=false

# Enable auto-save every N seconds
AUTO_SAVE_INTERVAL=30

# Deadline reminder intervals (hours before deadline)
REMINDER_INTERVALS=24,6,1

# ==========================================
# FEATURE FLAGS
# ==========================================

# Enable/disable automation features
ENABLE_AI_ANALYSIS=true
ENABLE_AUTO_REMINDERS=true
ENABLE_VERSION_CONTROL=true
ENABLE_TEAM_MATCHING=true
ENABLE_BLINDSPOT_DETECTION=true

# ==========================================
# RATE LIMITING
# ==========================================

# API rate limits (requests per minute)
RATE_LIMIT_IDEA_ANALYSIS=10
RATE_LIMIT_VALIDATION=30
RATE_LIMIT_NOTIFICATIONS=20
