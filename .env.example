# ==============================================================================
# DOGFOOD OS — HOSTED & PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (PostgreSQL 16)
# Supports Supabase, Neon, AWS RDS, Railway, or local Docker Postgres
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://dogfood:dogfood_secret@localhost:5432/dogfood_os?schema=public"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET="dogfood_jwt_super_secret_production_key_change_me_2026"

# ------------------------------------------------------------------------------
# GOOGLE OAUTH 2.0 (SIGN IN WITH GOOGLE)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized Javascript Origins: http://localhost:3000, https://your-hosted-domain.com
# Authorized Redirect URIs: http://localhost:3000/api/auth/callback/google, https://your-hosted-domain.com/api/auth/callback/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# PUBLIC API CONFIGURATION (Frontend to Backend Link)
# ------------------------------------------------------------------------------
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# ASSET STORAGE (MinIO / AWS S3)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="dogfood-assets"

# ------------------------------------------------------------------------------
# QUEUE & CACHE (Redis / Valkey / Upstash)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# DETERMINISTIC OFFLINE / HEURISTIC MODE
# Set to 'off' for zero-cost offline heuristic analysis (PRD requirement)
# ------------------------------------------------------------------------------
AI_PROVIDER="off"
